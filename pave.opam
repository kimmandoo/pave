# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml mobile coding agent"
description:
  "Terminal coding agent for iOS, Android, Flutter, and React Native repositories"
maintainer: ["mingyu5675@gmail.com"]
authors: ["kimmandoo"]
license: "MIT"
homepage: "https://github.com/kimmandoo/pave"
bug-reports: "https://github.com/kimmandoo/pave/issues"
depends: [
  "ocaml"
  "dune" {>= "3.14"}
  "yojson"
  "notty-community"
  "uutf"
  "uuseg"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/kimmandoo/pave.git"
